@model AutomobilBO

<div class="col-md-4 mb-4">
    <div class="card h-100 car-card shadow-sm">
        @{
            var slika = Model.PutanjeSlika.FirstOrDefault();
        }
        @if (slika != null)
        {
            <img src="@slika" class="card-img-top" alt="@Model.Naslov" />
        }
        else
        {
            <img src="https://placehold.co/400x200?text=Bez+slike" class="card-img-top" alt="Bez slike" />
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Naslov</h5>
            <p class="card-text text-muted mb-1">@Model.KategorijaNaziv</p>
            <p class="card-text mb-1">
                <strong>Trenutna cena:</strong> @Model.TrenutnaCena.ToString("N0") RSD
                <br />
                <small class="text-muted">(@Model.BrojPonuda ponuda)</small>
            </p>
            <p class="mb-2">
                @if (Model.JosNijePocela)
                {
                    <span class="badge badge-uskoro">Uskoro počinje</span>
                }
                else if (Model.Aktivna)
                {
                    <span class="badge badge-aktivna">Aktivna do @Model.DatumZavrsetka.ToString("dd.MM.yyyy HH:mm")</span>
                }
                else
                {
                    <span class="badge badge-zavrsena">Završena</span>
                }
            </p>
            <a asp-controller="Automobili" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary mt-auto">
                Pogledaj detalje
            </a>
        </div>
    </div>
</div>
