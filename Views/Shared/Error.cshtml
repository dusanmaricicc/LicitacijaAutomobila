@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}

<h1 class="text-danger">Greška</h1>
<h2 class="text-danger">Dogodila se greska prilikom obrade zahteva.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Nazad na pocetnu</a>
